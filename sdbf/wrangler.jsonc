{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"sd-beach-finder",
  "account_id":"e0ac5b4a7a2038d9a1c2fbeb153fa2f5",
  "main":"worker/index.mjs",
  "compatibility_date":"2026-11-22",
  "workers_dev":false,
  "routes":[{"pattern":"sdbeachfinder.gingernet.net","custom_domain":true}],
  "assets":{"directory":"./dist","run_worker_first":["/api/*"]},
  "d1_databases":[
    {"binding":"DB","database_name":"sd-beach-finder","database_id":"9be88a1c-d99d-46f8-94c2-04bf240c1f98"},
    {"binding":"WEATHER_DB","database_name":"weatherdash","database_id":"d9a37b85-19d4-468f-935a-f38dbd5356d3"}
  ],
  "browser":{"binding":"BROWSER"},
  "triggers":{"crons":["*/30 * * * *"]},
  "observability":{"enabled":true,"traces":{"enabled":true,"head_sampling_rate":0.05}}
}
